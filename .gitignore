# Jupyter autosave artifacts
.ipynb_checkpoints/

# Python
__pycache__/
*.py[cod]

# phase1-indy_mech_extension: large activation tensors and fitted-direction matrices live on
# https://huggingface.co/datasets/mild-rgb/indy-mech-extension-qwen3-8b-persona-probes
phase1-indy_mech_extension/**/*.npy
phase1-indy_mech_extension/**/*.npz
!phase1-indy_mech_extension/directions/steer_candidates.npz

# phase3-persona-direction: 7.4 GB of Qwen3-8B activation shards (X_*.npy) downloaded from the
# brrrt run; features_meta.json is kept so the loaders in code/brrrt/ know the layout.
phase3-persona-direction/results/brrrt/hf_dl/features/X_*.npy
phase3-persona-direction/results/brrrt/hf_dl/.cache/
